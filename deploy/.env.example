# docker-compose 的环境变量。
#
# 用法：cp .env.example .env  然后按需修改。
# .env 已被 .gitignore 拦截 —— 真实凭据不进仓库。
#
# ⚠️ 下面这些是**开发默认值**。生产部署必须换掉，
#    并改用 docker secret 或外部密钥管理，不要用环境变量明文。

MYSQL_ROOT_PASSWORD=thgh_root_dev
MYSQL_DATABASE=thgh
MYSQL_USER=thgh
MYSQL_PASSWORD=thgh_dev_2026

# 服务端对宿主机暴露的端口
THGH_PORT=9000
